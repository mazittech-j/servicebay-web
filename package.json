{
  "name": "servicebay-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env build.mjs && node --env-file-if-exists=.env scripts/bundle.mjs",
    "start": "node --env-file-if-exists=.env backend/start.mjs",
    "dev": "node --env-file-if-exists=.env backend/start.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test backend/test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "linkedom": "0.18.12"
  },
  "devDependencies": {
    "esbuild": "0.27.3"
  }
}
