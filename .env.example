# Local development: copy to .env and set your own owner password (24+ characters)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
SITE_ACCESS=private
# Set both to the full site origin on another host. SITE_ORIGIN is used at build time.
# On Render, PUBLIC_ORIGIN is optional: RENDER_EXTERNAL_URL is used automatically.
# Set both when using a custom domain.
# PUBLIC_ORIGIN=https://your-site.example
# SITE_ORIGIN=https://your-site.example
# Vercel and production Node require PostgreSQL. Keep the full pooled TLS connection string here.
DATABASE_URL=
# Copy these two server-side values from ServiceHub ERP.
SERVICEHUB_API_URL=
SERVICEHUB_API_KEY=
# Email receipts. Use a sender on a domain verified in Resend.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=
# Optional random server secret enabling encrypted sender setup in Studio > Integrations.
# Keep this value stable across redeploys.
MAIL_SETTINGS_KEY=
